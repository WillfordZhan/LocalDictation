# The working directory also holds local evaluation and release artifacts.
# Track an explicit source allowlist so user transcripts, probes and bundles
# cannot enter a public commit via git add .
/*
!/.gitignore
!/README.md
!/LICENSE
!/CHANGELOG.md
!/PRIVACY.md
!/THIRD_PARTY_NOTICES.md
!/.github/
!/macos/
!/backend/
!/packaging/
!/windows/
!/docs/
/docs/*
!/docs/app-icons.md
/macos/*
!/macos/*.swift
!/macos/Info.plist
!/macos/build.sh
!/macos/test.sh
!/macos/assets/
!/macos/tests/
!/macos/signing/
/macos/tests/*
!/macos/tests/*.swift
/macos/assets/*
!/macos/assets/AppIcon.icns
!/macos/assets/AppIcon.png
!/macos/assets/AppIconDotFormation.png
!/macos/assets/AppIconDotFormation.icns
!/macos/assets/AppIconSoftMist.png
!/macos/assets/AppIconSoftMist.icns
!/macos/assets/AppIconDarkGlow.png
!/macos/assets/AppIconDarkGlow.icns
!/macos/assets/README.md
!/macos/assets/generate-icon.swift
/macos/signing/*
!/macos/signing/*.py
!/macos/signing/*.swift
!/macos/signing/README.md
/backend/*
!/backend/*.py
!/backend/*.sh
!/backend/requirements.txt
!/backend/requirements-windows.txt
!/backend/windows-model-manifest.json
!/backend/model-manifest.json
!/backend/prompt-imports.json
/packaging/*
!/packaging/*.py
!/packaging/*.sh
!/packaging/refresh_macos_dock.swift
!/packaging/*.md
!/packaging/licenses/
/packaging/licenses/**
!/packaging/licenses/**/
!/packaging/licenses/SOURCES.json
!/packaging/licenses/mlx-whisper-0.4.3/LICENSE
!/packaging/licenses/sentencepiece-0.2.2/sentencepiece/LICENSE
!/packaging/licenses/sentencepiece-0.2.2/sentencepiece/third_party/abseil-cpp/LICENSE
!/packaging/licenses/sentencepiece-0.2.2/sentencepiece/third_party/darts_clone/LICENSE
!/packaging/licenses/sentencepiece-0.2.2/sentencepiece/third_party/esaxx/LICENSE
!/packaging/licenses/sentencepiece-0.2.2/sentencepiece/third_party/protobuf-lite/LICENSE
!/packaging/licenses/tokenizers-0.23.3/tokenizers/LICENSE
**/__pycache__/
**/.DS_Store
**/*.pyc
**/*.app/
**/.venv/
**/*keychain-db
**/*.p12
**/*.pfx
**/*.key
/windows/*
!/windows/*.md
!/windows/app/
!/windows/packaging/
!/windows/tests/
/windows/app/*
!/windows/app/*.cs
!/windows/app/*.xaml
!/windows/app/*.csproj
!/windows/app/*.ico
!/windows/app/*.manifest
/windows/packaging/*
!/windows/packaging/*.ps1
!/windows/packaging/*.py
!/windows/packaging/*.json
/windows/tests/*
!/windows/tests/*.ps1
!/windows/tests/*.py
!/windows/tests/*.cs
!/windows/tests/*.csproj
!/windows/tests/fixtures/
/windows/tests/fixtures/*
!/windows/tests/fixtures/*.wav
!/windows/tests/fixtures/*.md
**/bin/
**/obj/
