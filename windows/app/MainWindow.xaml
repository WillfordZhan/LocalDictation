<Window x:Class="LocalDictation.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="本地口述" Width="1100" Height="760" MinWidth="900" MinHeight="620"
 Background="White" WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI, Segoe UI">
 <Grid Margin="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="198"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#F6F6F7" CornerRadius="22" Padding="16,22">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top" Margin="10,9,0,36"><TextBlock Text="本地口述" FontWeight="Bold" FontSize="23"/><TextBlock Text="Windows 预览版" Foreground="{StaticResource Muted}" FontSize="11" Margin="1,9,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="10,16,0,0"><TextBlock x:Name="ServiceBadge" Text="正在检查配置" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="0.6.0" Foreground="#B0B3B9" FontSize="10" Margin="0,7,0,0"/></StackPanel>
    <StackPanel>
     <Button x:Name="HomeNav" Style="{StaticResource NavButton}" Tag="home" Click="Navigate"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Width="29" FontSize="17"/><TextBlock Text="首页" FontSize="15"/></StackPanel></Button>
     <Button x:Name="HistoryNav" Style="{StaticResource NavButton}" Tag="history" Click="Navigate"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" Width="29" FontSize="17"/><TextBlock Text="历史记录" FontSize="15"/></StackPanel></Button>
     <Button x:Name="DictionaryNav" Style="{StaticResource NavButton}" Tag="dictionary" Click="Navigate"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE82D;" Width="29" FontSize="17"/><TextBlock Text="个人词典" FontSize="15"/></StackPanel></Button>
     <Button x:Name="PromptsNav" Style="{StaticResource NavButton}" Tag="prompts" Click="Navigate"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" Width="29" FontSize="17"/><TextBlock Text="润色规则" FontSize="15"/></StackPanel></Button>
     <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Tag="settings" Click="Navigate"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Width="29" FontSize="17"/><TextBlock Text="设置" FontSize="15"/></StackPanel></Button>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="32,20,12,8">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock Text="说话，让文字跟上。" FontSize="34" FontWeight="SemiBold" Margin="0,4,0,10"/>
     <TextBlock Text="在输入框里按下快捷键，开始你的下一段表达。" Foreground="{StaticResource Muted}" Margin="0,0,0,32"/>
     <UniformGrid Columns="3" Margin="-5,0,-5,24">
      <Border Style="{StaticResource Card}" Margin="5,0"><StackPanel><TextBlock x:Name="WordCount" Text="0" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="累计输出字数" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="5,0"><StackPanel><TextBlock x:Name="SessionCount" Text="0" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="完成口述" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="5,0"><StackPanel><TextBlock x:Name="MinutesCount" Text="0 分钟" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="累计口述时间" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
     </UniformGrid>
     <Border Style="{StaticResource Card}" Background="#F8FAFE" BorderBrush="#E8EFFB" Margin="0,0,0,20">
      <StackPanel><TextBlock x:Name="ShortcutHeadline" Text="Ctrl + Alt + Space" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="按一下开始，再按一下结束。整理时可以继续说下一段。" Foreground="{StaticResource Muted}" Margin="0,12,0,22" TextWrapping="Wrap"/>
       <StackPanel Orientation="Horizontal"><Button x:Name="RecordButton" Content="开始口述" Style="{StaticResource PrimaryButton}" Click="ToggleRecordingClick"/><TextBlock x:Name="RecordingStatus" Text="准备就绪" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="18,0,0,0"/></StackPanel>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="本机模型" FontSize="18" FontWeight="SemiBold"/><Button x:Name="CheckButton" Content="检查配置" HorizontalAlignment="Right" Click="CheckSetupClick"/></DockPanel><TextBlock x:Name="ModelSummary" Text="首次使用需要下载模型，之后可离线口述。" Foreground="{StaticResource Muted}" Margin="0,14,0,16" TextWrapping="Wrap"/><ProgressBar x:Name="SetupProgress" Height="4" Visibility="Collapsed" IsIndeterminate="True" Margin="0,0,0,16"/><Button x:Name="RuntimeButton" Content="安装 Windows 运行库" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,0,0,12" Click="InstallRuntimeClick"/><Button x:Name="DownloadButton" Content="一键下载并配置" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="DownloadClick"/><TextBlock x:Name="SetupDetails" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="12"/></StackPanel></Border>
    </StackPanel>
   </ScrollViewer>
   <Grid x:Name="HistoryPage" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,22"><TextBlock Text="历史记录" Style="{StaticResource PageTitle}" Margin="0"/><TextBox x:Name="HistorySearch" Width="190" HorizontalAlignment="Right" ToolTip="搜索原文和输出" TextChanged="HistorySearchChanged"/></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Padding="9"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ListBox x:Name="HistoryList" SelectionChanged="HistorySelected"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,12"/><Setter Property="Margin" Value="0,1"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DateLabel}" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" FontSize="13"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      <DockPanel x:Name="Pagination" Grid.Row="1" Margin="3,8,3,1"><Button Content="‹" Padding="10,3" Click="PreviousPage"/><Button Content="›" Padding="10,3" DockPanel.Dock="Right" Click="NextPage"/><TextBlock x:Name="PageLabel" Text="1 / 1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}"/></DockPanel>
     </Grid></Border>
     <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Padding="20"><DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="最终输出" FontWeight="SemiBold"/><Button Content="复制" Padding="10,4" HorizontalAlignment="Right" Click="CopyHistory"/></DockPanel><TextBox x:Name="FinalText" IsReadOnly="True" BorderThickness="0" Padding="0" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></DockPanel></Border>
      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20"><DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="ASR 原文" FontWeight="SemiBold"/><Button Content="删除" Padding="10,4" HorizontalAlignment="Right" Foreground="#BC5D5D" Click="DeleteHistory"/></DockPanel><TextBlock x:Name="HistoryMetadata" DockPanel.Dock="Bottom" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/><TextBox x:Name="RawText" IsReadOnly="True" BorderThickness="0" Padding="0" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></DockPanel></Border>
     </Grid>
    </Grid>
   </Grid>
   <Grid x:Name="DictionaryPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="个人词典" Style="{StaticResource PageTitle}"/>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,18"><DockPanel><Button Content="添加" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Click="AddVocabulary"/><TextBox x:Name="VocabularyInput" ToolTip="人名、项目名或专业术语" KeyDown="VocabularyKeyDown"/></DockPanel></Border>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20"><DockPanel><TextBlock x:Name="VocabularyCount" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,12"/><ListBox x:Name="VocabularyList"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="2,7"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><DockPanel><Button Content="删除" DockPanel.Dock="Right" Tag="{Binding}" Padding="10,5" Width="58" Click="DeleteVocabulary"/><TextBlock Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,15,0"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
   </Grid>
   <Grid x:Name="PromptsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="润色规则" Style="{StaticResource PageTitle}"/>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Padding="9"><DockPanel><TextBlock x:Name="CurrentModel" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" Margin="8,15,8,5"/><ListBox x:Name="PromptList" DisplayMemberPath="Label" SelectionChanged="PromptSelected"/></DockPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"><DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><StackPanel Orientation="Horizontal"><Button Content="保存为新版本" Style="{StaticResource PrimaryButton}" Click="SavePrompt"/><Button Content="启用选中版本" Margin="10,0,0,0" Click="ActivatePrompt"/></StackPanel><TextBlock x:Name="PromptStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="名称" Foreground="{StaticResource Muted}" FontSize="12"/><TextBox x:Name="PromptName" Margin="0,6,0,15"/><TextBlock Text="整理规则" Foreground="{StaticResource Muted}" FontSize="12"/><TextBox x:Name="PromptSystem" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="230" VerticalScrollBarVisibility="Auto" Margin="0,6,0,15"/><Expander Header="输入提示与示例"><StackPanel Margin="0,10,0,0"><TextBox x:Name="PromptPrefix" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"/><TextBox x:Name="PromptExamples" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" Margin="0,10,0,0" FontFamily="Consolas" FontSize="12"/></StackPanel></Expander></StackPanel></ScrollViewer></DockPanel></Border>
    </Grid>
   </Grid>
   <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="设置" Style="{StaticResource PageTitle}"/><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="录音快捷键" FontSize="17" FontWeight="SemiBold"/><TextBox x:Name="ShortcutBox" IsReadOnly="True" PreviewKeyDown="CaptureShortcut" Margin="0,16,0,8" HorizontalAlignment="Left" Width="260"/><TextBlock Text="点击上方，按下新的组合键。Windows 通常无法识别单独的 Fn 键。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><CheckBox x:Name="CleanupCheck" Content="识别后润色文字" FontSize="15" Checked="CleanupChanged" Unchecked="CleanupChanged"/><TextBlock Text="保留原意，去掉重复与停顿；完整保留原文供对照。" Margin="24,10,0,0" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="数据与后台运行" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="关闭窗口后仍在托盘运行。历史、词典和规则独立保存在本机，更新应用不会清空。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,13,0,18"/><StackPanel Orientation="Horizontal"><Button Content="打开数据文件夹" Click="OpenDataFolder"/><Button Content="退出本地口述" Margin="12,0,0,0" Click="QuitClick"/></StackPanel></StackPanel></Border></StackPanel></ScrollViewer>
   <TextBlock x:Name="StatusMessage" Grid.Row="1" Foreground="#878A91" TextWrapping="Wrap" FontSize="12" Margin="0,18,0,0" MinHeight="18"/>
  </Grid>
 </Grid>
</Window>
